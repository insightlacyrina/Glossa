<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- This fixture provider exists only in the separate instrumentation APK. -->
        <provider android:name="local.quietpaper.FixtureProvider" android:authorities="local.quietpaper.test.source" android:exported="true" />
        <provider android:name="local.quietpaper.SafFixtureDocumentsProvider"
            android:authorities="local.quietpaper.test.documents" android:exported="true"
            android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <provider android:name="local.quietpaper.SafFixtureControlProvider"
            android:authorities="local.quietpaper.test.safcontrol" android:exported="true" />
    </application>
</manifest>
