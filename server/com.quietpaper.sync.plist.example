<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.quietpaper.sync</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/YOUR_USER/quiet-paper/server/index.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/YOUR_USER/quiet-paper</string>
  <key>EnvironmentVariables</key><dict>
    <key>QUIET_PAPER_TOKEN</key><string>REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_24_CHARACTERS</string>
    <key>QUIET_PAPER_DATA</key><string>/Users/YOUR_USER/Library/Application Support/Quiet Paper</string>
    <key>QUIET_PAPER_ORIGINS</key><string>https://paper.example.com,https://appassets.quietpaper.local</string>
    <key>HOST</key><string>127.0.0.1</string>
    <key>PORT</key><string>8787</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/quiet-paper-sync.log</string>
  <key>StandardErrorPath</key><string>/tmp/quiet-paper-sync-error.log</string>
</dict></plist>
